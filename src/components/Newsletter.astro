---
import Pattern from "./Pattern.astro";
// Posts to /api/subscribe, a Worker route that adds the address to a Brevo list (see NEWSLETTER.md).
const endpoint = import.meta.env.PUBLIC_NEWSLETTER_ENDPOINT || "/api/subscribe";
---

<section class="band has-pattern">
	<Pattern area="newsletter" />
	<div class="container grid">
		<div>
			<h2>Get new posts by email.</h2>
			<p>One email when a post goes live. Unsubscribe anytime.</p>
		</div>
		<form novalidate data-endpoint={endpoint}>
			<div class="row">
				<input type="email" name="email" placeholder="you@example.com" aria-label="Email address" autocomplete="email" required />
				<input class="hp" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
				<button class="subscribe" type="submit">Subscribe</button>
			</div>
			<p class="msg" role="status" aria-live="polite"></p>
		</form>
	</div>
</section>

<style>
	.band {
		border-top: 1px solid var(--line);
		padding: 64px 0;
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
		gap: 32px 48px;
		align-items: center;
	}
	h2 {
		font-size: clamp(26px, 3vw, 34px);
		letter-spacing: -0.025em;
		line-height: 1.15;
	}
	p {
		margin: 10px 0 0;
		color: var(--muted);
	}
	.row {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
	}
	input {
		flex: 1 1 220px;
		height: 46px;
		padding: 0 20px;
		border: 1px solid var(--line);
		border-radius: 999px;
		background: var(--bg);
		color: var(--fg);
		font: inherit;
		font-size: 15px;
	}
	input:focus {
		outline: none;
		border-color: var(--accent);
	}
	.subscribe {
		height: 46px;
		padding: 0 22px;
		border: 0;
		border-radius: 999px;
		background: var(--accent);
		color: var(--accent-fg);
		font: inherit;
		font-size: 15px;
		font-weight: 500;
		cursor: pointer;
	}
	.subscribe:hover {
		opacity: 0.9;
	}
	.hp {
		position: absolute;
		left: -9999px;
		width: 1px;
		height: 1px;
		opacity: 0;
	}
	.msg {
		min-height: 1.5em;
		margin: 10px 0 0;
		font-size: 14px;
	}
</style>

<script>
	document.querySelectorAll<HTMLFormElement>(".band form").forEach((form) => {
		const msg = form.querySelector<HTMLElement>(".msg")!;
		form.addEventListener("submit", async (e) => {
			e.preventDefault();
			const email = (new FormData(form).get("email") as string).trim();
			msg.style.color = "";
			if (!/^\S+@\S+\.\S+$/.test(email)) {
				msg.textContent = "Enter a valid email address.";
				msg.style.color = "#c0392b";
				return;
			}
			const endpoint = form.dataset.endpoint!;
			const btn = form.querySelector<HTMLButtonElement>(".subscribe")!;
			btn.disabled = true;
			try {
				const res = await fetch(endpoint, {
					method: "POST",
					headers: { "Content-Type": "application/json" },
					body: JSON.stringify({ email, website: new FormData(form).get("website") }),
				});
				const out = (await res.json().catch(() => ({}))) as { ok?: boolean; error?: string; confirm?: boolean };
				if (res.ok && out.ok) {
					msg.textContent = out.confirm
						? `Almost there. Check ${email} for a confirmation email and click the link.`
						: `You’re subscribed. The next post will arrive at ${email}.`;
					form.reset();
					(window as any).track?.("newsletter_signup");
				} else if (out.error === "not_configured") {
					msg.textContent = "Subscriptions aren't open yet. Check back soon.";
				} else if (out.error === "invalid_email") {
					msg.textContent = "Enter a valid email address.";
					msg.style.color = "#c0392b";
				} else {
					throw new Error(out.error || String(res.status));
				}
			} catch {
				msg.textContent = "Something went wrong. Please try again.";
				msg.style.color = "#c0392b";
			} finally {
				btn.disabled = false;
			}
		});
	});
</script>
