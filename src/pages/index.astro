---
import BaseLayout from "../layouts/BaseLayout.astro";
import Pattern from "../components/Pattern.astro";
import Listing from "../components/Listing.astro";
import Newsletter from "../components/Newsletter.astro";
import { getPosts } from "../lib/posts";

const posts = await getPosts();
---

<BaseLayout>
	<main>
		<section class="hero has-pattern">
			<Pattern area="hero" />
			<div class="container inner">
				<h1>Cloud architecture for the real world, not just the whiteboard.</h1>
				<p>
					I’m Suman Kondla, a cloud solutions architect. I write about infrastructure, DevOps, AI workloads, and
					security across Azure, AWS, Google Cloud, and Cloudflare, with practical lessons and code you can reuse.
				</p>
			</div>
		</section>
		<Listing posts={posts} />
		<Newsletter />
	</main>
</BaseLayout>

<style>
	.hero {
		padding: 80px 0 64px;
		border-bottom: 1px solid var(--line);
	}
	h1 {
		font-size: clamp(38px, 5.6vw, 68px);
		line-height: 1.02;
		letter-spacing: -0.035em;
		max-width: 20ch;
		text-wrap: balance;
	}
	p {
		margin: 24px 0 0;
		max-width: 56ch;
		font-family: var(--serif);
		font-size: 21px;
		line-height: 1.5;
		color: var(--muted);
		text-wrap: pretty;
	}
</style>
