---
import { SOCIAL } from "../consts";
---

<footer>
	<div class="container row">
		<span>© 2026 Suman Kondla · sumankondla.com</span>
		<span class="links">
			<a href="/rss.xml">RSS</a>
			{SOCIAL.linkedin && <a href={SOCIAL.linkedin} rel="me noopener">LinkedIn</a>}
			<a href={SOCIAL.github} rel="me noopener">GitHub</a>
		</span>
	</div>
</footer>

<style>
	footer {
		border-top: 1px solid var(--line);
		padding: 28px 0;
		font-size: 14px;
		color: var(--muted);
	}
	.row {
		display: flex;
		flex-wrap: wrap;
		gap: 12px 24px;
		justify-content: space-between;
	}
	.links {
		display: flex;
		gap: 20px;
	}
	a {
		color: var(--muted);
	}
	a:hover {
		color: var(--accent);
	}
</style>
