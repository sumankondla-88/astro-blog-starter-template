---
import BaseLayout from "../layouts/BaseLayout.astro";
import Pattern from "../components/Pattern.astro";
import { SOCIAL } from "../consts";
import { categories, getPosts, publicFileExists } from "../lib/posts";

const posts = await getPosts();
const count = (slug: string) => posts.filter((p) => p.data.category === slug).length;
// Drop the portrait at public/images/suman-portrait.jpg and it is picked up automatically.
const portrait = "/images/suman-portrait.jpg";
const hasPortrait = publicFileExists(portrait);
---

<BaseLayout title="About" description="Suman Kondla is a senior cloud solutions architect writing about cloud infrastructure, DevOps, and AI workloads across Azure, AWS, Google Cloud, and Cloudflare.">
	<main class="container page">
		<section class="intro has-pattern">
			<Pattern area="about" />
			<div class="portrait">
				{hasPortrait ? <img src={portrait} alt="Suman Kondla" /> : <span class="mono">Portrait</span>}
			</div>
			<div class="text">
				<h1>About</h1>
				<div class="copy">
					<p>I’m Suman Kondla, a senior cloud solutions architect. I design and run cloud environments for government portals, multi-tenant SaaS products, and AI workloads.</p>
					<p class="muted">This site covers infrastructure across Azure, AWS, Google Cloud, and Cloudflare, including infrastructure as code, deployment pipelines, identity, networking, and cost. I write up practical patterns, lessons learned, and code you can reuse.</p>
					<p class="muted">Views here are my own and don’t represent my employer or clients.</p>
				</div>
				<div class="links">
					{SOCIAL.linkedin && <a class="pill" href={SOCIAL.linkedin} rel="me noopener">LinkedIn</a>}
					<a class="pill" href={SOCIAL.github} rel="me noopener">GitHub</a>
					<a class="pill" href={SOCIAL.email}>Email</a>
				</div>
			</div>
		</section>

		<section class="topics">
			<h2>What I write about</h2>
			<div class="grid">
				{
					categories.map((c) => (
						<div class="topic">
							<a href={`/category/${c.slug}/`}>{c.label}</a>
							<p>{c.description}</p>
							<div class="mono n">{count(c.slug)} {count(c.slug) === 1 ? "post" : "posts"}</div>
						</div>
					))
				}
			</div>
		</section>
	</main>
</BaseLayout>

<style>
	.page {
		padding-top: 72px;
		padding-bottom: 88px;
		display: flex;
		flex-direction: column;
		gap: 72px;
	}
	.intro {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
		gap: 48px;
		align-items: start;
	}
	.portrait {
		aspect-ratio: 4/5;
		width: 100%;
		max-width: 340px;
		border-radius: 16px;
		overflow: hidden;
		background: var(--surface);
		border: 1px solid var(--line);
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 12px;
		color: var(--faint);
		text-transform: uppercase;
	}
	.portrait img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.text {
		grid-column: span 2;
		display: flex;
		flex-direction: column;
		gap: 20px;
		min-width: 0;
	}
	h1 {
		font-size: clamp(36px, 4.6vw, 56px);
		line-height: 1.05;
		letter-spacing: -0.032em;
	}
	.copy {
		font-family: var(--serif);
		font-size: 21px;
		line-height: 1.6;
		max-width: 58ch;
		display: flex;
		flex-direction: column;
		gap: 18px;
		text-wrap: pretty;
	}
	.copy p {
		margin: 0;
	}
	.muted {
		color: var(--muted);
	}
	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		padding-top: 8px;
	}
	.topics {
		display: flex;
		flex-direction: column;
		gap: 28px;
		border-top: 1px solid var(--line);
		padding-top: 40px;
	}
	.topics h2 {
		font-size: 15px;
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
		gap: 32px 40px;
	}
	.topic {
		display: flex;
		flex-direction: column;
		gap: 6px;
	}
	@media (max-width: 640px) {
		.page {
			padding-top: 48px;
			gap: 56px;
		}
		.text {
			grid-column: auto;
		}
		.copy {
			font-size: 19px;
		}
	}
	.topic a {
		font-size: 18px;
		font-weight: 600;
		letter-spacing: -0.01em;
		text-decoration: none;
	}
	.topic p {
		margin: 0;
		font-size: 15px;
		line-height: 1.55;
		color: var(--muted);
	}
	.n {
		font-size: 12px;
		color: var(--faint);
	}
</style>
