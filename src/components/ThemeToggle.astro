---
---

<button class="theme-toggle" type="button" aria-label="Toggle color theme" data-theme-toggle>
	<svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
	<svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
</button>

<style>
	.theme-toggle {
		width: 34px;
		height: 34px;
		border-radius: 50%;
		border: 1px solid var(--line);
		background: transparent;
		color: var(--fg);
		display: inline-flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		padding: 0;
	}
	.theme-toggle:hover {
		background: var(--surface);
	}
	.icon-sun {
		display: none;
	}
	:global(:root[data-theme="dark"]) .icon-sun {
		display: block;
	}
	:global(:root[data-theme="dark"]) .icon-moon {
		display: none;
	}
</style>

<script>
	document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]").forEach((btn) => {
		btn.addEventListener("click", () => {
			const next = document.documentElement.getAttribute("data-theme") === "dark" ? "light" : "dark";
			document.documentElement.setAttribute("data-theme", next);
			try {
				localStorage.setItem("sk-blog-theme", next);
			} catch {}
			window.dispatchEvent(new CustomEvent("sk-theme", { detail: next }));
			(window as any).track?.("theme_toggle", { theme: next });
		});
	});
</script>
