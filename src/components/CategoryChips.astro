---
import { categories } from "../lib/posts";

interface Props {
	active?: string; // category slug; omit for "All"
}
const { active } = Astro.props;
---

<nav class="chips" aria-label="Categories">
	<a href="/" class:list={["chip", { on: !active }]} aria-current={!active ? "page" : undefined}>All</a>
	{
		categories.map((c) => (
			<a href={`/category/${c.slug}/`} class:list={["chip", { on: active === c.slug }]} aria-current={active === c.slug ? "page" : undefined}>
				{c.label}
			</a>
		))
	}
</nav>

<style>
	.chips {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}
	.chip {
		padding: 7px 13px;
		font-size: 14px;
		border-radius: 999px;
		border: 1px solid var(--line);
		color: var(--muted);
		text-decoration: none;
	}
	.chip:hover {
		color: var(--fg);
		background: var(--surface);
	}
	.chip.on {
		background: var(--fg);
		border-color: var(--fg);
		color: var(--bg);
	}
</style>
