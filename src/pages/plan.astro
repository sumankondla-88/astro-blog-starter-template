---
// Internal editorial plan: noindex, excluded from the sitemap, not linked from the nav.
// Protect with Cloudflare Access (add /plan* to the Keystatic application) if it should not be public.
import BaseLayout from "../layouts/BaseLayout.astro";
import planMd from "../data/EDITORIAL_PLAN.md?raw";
import { getAllPostsIncludingDrafts, categoryBySlug, formatShortDate } from "../lib/posts";

const posts = await getAllPostsIncludingDrafts();
const byTitle = new Map(posts.map((p) => [p.data.title, p]));

const rows = planMd
	.split("\n")
	.filter((l) => /^\|\s*\d+\s*\|/.test(l))
	.map((l) => l.split("|").map((c) => c.trim()))
	.map(([, num, , title, , format, status]) => ({ num, title, format, status, post: byTitle.get(title) }));
---

<BaseLayout title="Editorial plan" noindex description="Internal editorial plan.">
	<main class="container page">
		<div class="intro">
			<div class="eyebrow accent">Internal</div>
			<h1>Editorial plan</h1>
			<p>{rows.length} posts, October 19 to December 8, 2026.</p>
		</div>
		<div class="rows">
			{
				rows.map((r) => (
					<div class="row">
						<div class="mono when">
							<span class="num">{r.num}</span>
							<span>{r.post && formatShortDate(r.post.data.pubDate)}</span>
						</div>
						<div class="what">
							{r.post ? <a href={`/blog/${r.post.id}/`}>{r.title}</a> : <span class="t">{r.title}</span>}
							{r.post && <div class="s">{r.post.data.description}</div>}
						</div>
						<div class="tags">
							{r.post && <span class="tag">{categoryBySlug(r.post.data.category).label}</span>}
							<span class="tag">{r.format}</span>
							<span class:list={["tag", r.status === "Draft ready" ? "ready" : "other"]}>{r.status}</span>
						</div>
					</div>
				))
			}
		</div>
	</main>
</BaseLayout>

<style>
	.page {
		padding-top: 64px;
		padding-bottom: 88px;
		display: flex;
		flex-direction: column;
		gap: 36px;
	}
	.intro {
		display: flex;
		flex-direction: column;
		gap: 14px;
	}
	.accent {
		color: var(--accent);
	}
	h1 {
		font-size: clamp(34px, 4.4vw, 52px);
		line-height: 1.05;
		letter-spacing: -0.03em;
	}
	.intro p {
		margin: 0;
		color: var(--muted);
		font-size: 17px;
	}
	.rows {
		border-top: 1px solid var(--line);
	}
	.row {
		display: flex;
		flex-wrap: wrap;
		gap: 8px 24px;
		padding: 20px 8px;
		border-bottom: 1px solid var(--line);
		align-items: baseline;
	}
	.row:hover {
		background: var(--surface);
	}
	.when {
		flex: 0 0 120px;
		display: flex;
		gap: 14px;
		font-size: 13px;
		color: var(--muted);
	}
	.num {
		color: var(--faint);
	}
	.what {
		flex: 1 1 420px;
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 6px;
	}
	.what a,
	.t {
		font-size: 18px;
		font-weight: 600;
		line-height: 1.3;
		letter-spacing: -0.01em;
		text-decoration: none;
	}
	.s {
		font-size: 14.5px;
		line-height: 1.5;
		color: var(--muted);
		max-width: 72ch;
	}
	.tags {
		flex: 0 0 220px;
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
		font-size: 12.5px;
	}
	.tag {
		padding: 3px 9px;
		border: 1px solid var(--line);
		border-radius: 999px;
		color: var(--muted);
	}
	.tag.ready {
		background: var(--accent);
		border-color: var(--accent);
		color: var(--accent-fg);
	}
	.tag.other {
		background: var(--surface);
	}
</style>
