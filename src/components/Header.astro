---
import ThemeToggle from "./ThemeToggle.astro";
const path = Astro.url.pathname;
const writingActive = path === "/" || path.startsWith("/blog") || path.startsWith("/category");
const aboutActive = path.startsWith("/about");
---

<header>
	<div class="container bar">
		<a class="brand" href="/">Suman Kondla<span class="mono"> / notes</span></a>
		<nav>
			<a href="/" class:list={{ active: writingActive }}>Writing</a>
			<a href="/about/" class:list={{ active: aboutActive }}>About</a>
			<ThemeToggle />
		</nav>
	</div>
</header>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 20;
		background: var(--hdr);
		-webkit-backdrop-filter: blur(12px);
		backdrop-filter: blur(12px);
		border-bottom: 1px solid var(--line);
	}
	.bar {
		height: 64px;
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	.brand {
		white-space: nowrap;
		font-size: 17px;
		font-weight: 600;
		text-decoration: none;
	}
	.brand .mono {
		font-size: 12px;
		color: var(--faint);
		font-weight: 400;
	}
	nav {
		display: flex;
		align-items: center;
		gap: 22px;
	}
	nav a {
		font-size: 15px;
		color: var(--muted);
		text-decoration: none;
	}
	nav a:hover,
	nav a.active {
		color: var(--fg);
	}
</style>
