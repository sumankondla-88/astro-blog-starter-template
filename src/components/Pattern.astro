---
// Decorative dot grid + color glows. Parent needs class "has-pattern".
interface Props {
	area: "hero" | "article" | "about" | "newsletter";
}
const { area } = Astro.props;
const cfg = {
	hero: {
		top: "0",
		mask: "radial-gradient(ellipse 60% 90% at 78% 40%,#000 15%,transparent 72%)",
		glow: "radial-gradient(38% 70% at 88% 18%,var(--glow-a),transparent 70%),radial-gradient(30% 60% at 62% 95%,var(--glow-b),transparent 70%),radial-gradient(26% 55% at 100% 85%,var(--glow-c),transparent 70%)",
	},
	article: {
		top: "0",
		mask: "linear-gradient(180deg,#000 0%,transparent 55%)",
		glow: "radial-gradient(34% 40% at 85% 6%,var(--glow-a),transparent 70%),radial-gradient(28% 34% at 66% 30%,var(--glow-c),transparent 70%),radial-gradient(24% 30% at 4% 2%,var(--glow-b),transparent 70%)",
	},
	about: {
		top: "-72px",
		mask: "radial-gradient(ellipse 55% 80% at 80% 20%,#000 10%,transparent 70%)",
		glow: "radial-gradient(34% 60% at 90% 8%,var(--glow-c),transparent 70%),radial-gradient(30% 50% at 60% 40%,var(--glow-a),transparent 70%),radial-gradient(22% 40% at 14% 0%,var(--glow-b),transparent 70%)",
	},
	newsletter: {
		top: "0",
		mask: "radial-gradient(ellipse 50% 100% at 20% 50%,#000 10%,transparent 70%)",
		glow: "radial-gradient(30% 90% at 8% 50%,var(--glow-b),transparent 70%),radial-gradient(28% 80% at 34% 100%,var(--glow-a),transparent 70%),radial-gradient(22% 70% at 96% 10%,var(--glow-c),transparent 70%)",
	},
}[area];
---

<div class="pattern" style={`top:${cfg.top}`} aria-hidden="true">
	<div class="dots" style={`-webkit-mask-image:${cfg.mask};mask-image:${cfg.mask}`}></div>
	<div style={`background:${cfg.glow}`}></div>
</div>
