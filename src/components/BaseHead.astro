---
import "../styles/global.css";
import { SITE_DESCRIPTION, SITE_HOME_TITLE, SITE_TITLE, SITE_URL, AUTHOR, SOCIAL } from "../consts";

interface Props {
	title?: string; // page title without the site suffix; omit for home
	description?: string;
	image?: string;
	type?: "website" | "article";
	pubDate?: Date;
	modDate?: Date;
	section?: string;
	noindex?: boolean;
	jsonLd?: boolean;
}
const { title, description = SITE_DESCRIPTION, image, type = "website", pubDate, modDate, section, noindex = false, jsonLd = false } = Astro.props;

const site = Astro.site ?? new URL(SITE_URL);
const fullTitle = title ? `${title} · ${SITE_TITLE}` : SITE_HOME_TITLE;
const canonical = new URL(Astro.url.pathname, site).toString();
const ogImage = new URL(image || "/og-default.png", site).toString();
const modified = modDate ?? pubDate;

const ga = import.meta.env.PROD ? import.meta.env.PUBLIC_GA_ID : undefined;

const ld = jsonLd && pubDate
	? {
			"@context": "https://schema.org",
			"@type": "BlogPosting",
			headline: title,
			description,
			image: ogImage,
			datePublished: pubDate.toISOString(),
			dateModified: modified!.toISOString(),
			author: { "@type": "Person", name: AUTHOR, sameAs: [SOCIAL.linkedin, SOCIAL.github].filter(Boolean) },
			mainEntityOfPage: { "@type": "WebPage", "@id": canonical },
		}
	: null;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/png" href="/images/logos/logo.png" />
<link rel="icon" type="image/png" href="/images/logos/dark_logo.png" media="(prefers-color-scheme: dark)" />
<meta name="generator" content={Astro.generator} />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href="/rss.xml" />

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:type" content={type} />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={title ?? SITE_HOME_TITLE} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
{pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}
{modified && <meta property="article:modified_time" content={modified.toISOString()} />}
{section && <meta property="article:section" content={section} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title ?? SITE_HOME_TITLE} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

{ld && <script type="application/ld+json" set:html={JSON.stringify(ld)} />}

<!-- Theme before paint; analytics helper -->
<script is:inline>
	(function () {
		var t = "light";
		try { t = localStorage.getItem("sk-blog-theme") || "light"; } catch (e) {}
		document.documentElement.setAttribute("data-theme", t === "dark" ? "dark" : "light");
		window.dataLayer = window.dataLayer || [];
		window.gtag = function () { window.dataLayer.push(arguments); };
		window.track = function (name, params) { if (window.__ga) window.gtag("event", name, params || {}); };
	})();
</script>

{
	ga && (
		<script is:inline define:vars={{ ga }}>
			// Consent Mode v2: everything denied until the visitor accepts.
			gtag("consent", "default", { ad_storage: "denied", ad_user_data: "denied", ad_personalization: "denied", analytics_storage: "denied" });
			window.__ga = true;
			var granted = false;
			try { granted = localStorage.getItem("sk-consent") === "granted"; } catch (e) {}
			if (granted) gtag("consent", "update", { analytics_storage: "granted" });
			var s = document.createElement("script");
			s.async = true;
			s.src = "https://www.googletagmanager.com/gtag/js?id=" + ga;
			document.head.appendChild(s);
			gtag("js", new Date());
			gtag("config", ga);
		</script>
	)
}
