---
// Home / category body: featured post (home "All" only), chips, and the post grid.
import Cover from "./Cover.astro";
import PostCard from "./PostCard.astro";
import CategoryChips from "./CategoryChips.astro";
import { categoryBySlug, formatDate, readMinutes, type Post } from "../lib/posts";

interface Props {
	posts: Post[];
	category?: string;
}
const { posts, category } = Astro.props;
const featured = category ? undefined : posts.find((p) => p.data.featured);
const grid = posts.filter((p) => p !== featured);
---

{
	featured && (
		<section class="featured container">
			<a class="cover-link" href={`/blog/${featured.id}/`} tabindex="-1" aria-hidden="true">
				<Cover src={featured.data.heroImage} category={featured.data.category} ratio="16/10" radius={14} eager />
			</a>
			<div class="text">
				<div class="eyebrow">
					<span class="latest">Latest</span> · {categoryBySlug(featured.data.category).label} · {featured.data.format}
				</div>
				<h2>
					<a href={`/blog/${featured.id}/`}>{featured.data.title}</a>
				</h2>
				<p>{featured.data.description}</p>
				<div class="row">
					<a class="btn" href={`/blog/${featured.id}/`}>Read the post</a>
					<span class="mono meta">
						{formatDate(featured.data.pubDate)} · {readMinutes(featured.body)} min read
					</span>
				</div>
			</div>
		</section>
	)
}

<section class="all container">
	<div class="head">
		<h2>{category ? categoryBySlug(category).label : "All writing"}</h2>
		<CategoryChips active={category} />
	</div>
	{
		grid.length ? (
			<div class="grid">{grid.map((post) => <PostCard post={post} />)}</div>
		) : (
			!featured && <p class="empty">No posts in this category yet. Subscribe below to get the first one.</p>
		)
	}
</section>

<style>
	.featured {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 440px), 1fr));
		gap: 40px;
		padding-top: 56px;
		padding-bottom: 56px;
		border-bottom: 1px solid var(--line);
		align-items: center;
	}
	.featured > * {
		min-width: 0;
	}
	.text {
		display: flex;
		flex-direction: column;
		gap: 18px;
	}
	h2 {
		font-size: clamp(28px, 3.4vw, 40px);
		line-height: 1.1;
		letter-spacing: -0.025em;
		text-wrap: balance;
	}
	.featured h2 a {
		text-decoration: none;
	}
	.text p {
		margin: 0;
		font-family: var(--serif);
		font-size: 19px;
		line-height: 1.55;
		color: var(--muted);
	}
	.row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 14px 18px;
	}
	.meta {
		font-size: 12px;
		color: var(--faint);
	}
	.all {
		padding-top: 56px;
		padding-bottom: 80px;
		display: flex;
		flex-direction: column;
		gap: 32px;
	}
	.head {
		display: flex;
		flex-direction: column;
		gap: 16px;
	}
	.head h2 {
		font-size: 15px;
		letter-spacing: 0;
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
		gap: 56px 32px;
	}
	.empty {
		margin: 0;
		color: var(--muted);
	}
</style>
